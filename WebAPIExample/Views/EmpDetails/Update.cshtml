 <html>
    <body>
        <h1>Web API Update</h1>
        <form>
            Existing Employee Id : <input type="text" id="eid" /> <br /><br />
            Employee Name : <input type="text" id="ename"/><br /><br />
            Employee Salary : <input type="text" id="esal"/> <br /><br />
            <input type="button" id="btn1" value="Update"/> <br />
            <div id="result"></div>
        </form>
        <script src="~/Scripts/jquery-3.7.0.js"></script>
        <script>
            $("#btn1").click(fun1); 

                function fun1(event) {
                    event.preventDefault();
                    var myData = {
                        "EmpId": $("#eid").val(),
                        "EmpName": $("#ename").val(),
                        "EmpSalary": $("#esal").val()
                    };
                    $.ajax({ url: "/api/Employee", type:"PUT", data: myData, success: fun2, error: fun3 })
                } 
            
            function fun2(response) {
               $("#result").html(response);
            }
            function fun3(err) {
                alert(err.responseText);
            }
        </script>
    </body>
</html>