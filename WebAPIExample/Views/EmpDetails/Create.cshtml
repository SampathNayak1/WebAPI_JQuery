
<html>
    <body>
        <h1>Web API Get</h1>
        <form>
            <input type="button" id="btn1" value="Get Data"/>
            <table id="tbl1" border="1"></table>
        </form>
        <script src="~/Scripts/jquery-3.7.0.js"></script>
        <script>
            $("#btn1").click(fun1);
            function fun1() {
                $.ajax({ url: "/api/Employee", type:"GET" , success: fun2, error: fun3 });
            }
            function fun2(response) {
                $("#tbl1").html("<tr> <th>Emp Id</th> <th>Emp Name</th> <th>Emp Sal</th> </tr>")
                for (var i = 0; i < response.length; i++) {
                    $("#tbl1").append("<tr><td>" + response[i].EmpId + "</td><td>" + response[i].EmpName + "</td><td>" +
                        response[i].EmpSalary + "</td></tr>")
                }
            }
            function fun3(err) {
                alert(err.responseText);
            }
        </script>
    </body>
</html>